<UserControl x:Class="Bansa.Views.NetworkToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="RootScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,24,24">

            <!-- Header -->
            <TextBlock Text="Network Tools" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Interface priority and per-app connection binding."
                       Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,16" />

            <!-- ════ Interface priority ══════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Interface priority" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                    <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Windows sends traffic out the connection with the lowest metric. Pick which one it should prefer when both Wi-Fi and Ethernet are connected." />

                    <Border Background="#22F59E0B" BorderBrush="#55F59E0B" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#F59E0B">
                            <Run FontWeight="SemiBold" Text="This is a system-wide change. " />
                            <Run Text="Unlike Bansa's other settings it persists across reconnects and reboots (that's the point). Use the buttons below to put everything back." />
                        </TextBlock>
                    </Border>

                    <TextBlock x:Name="IfaceActiveText" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />

                    <TextBlock x:Name="IfaceEmpty" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}"
                               Text="Reading interfaces…" />
                    <ItemsControl x:Name="IfaceItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextBrush}" />
                                                <Border Background="{DynamicResource AccentMutedBrush}" CornerRadius="4"
                                                        Padding="6,1" Margin="8,0,0,0"
                                                        Visibility="{Binding BadgeVisibility}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Medium"
                                                               Foreground="{DynamicResource AccentLightBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                       Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding PreferLabel}" Command="{Binding PreferCommand}"
                                                IsEnabled="{Binding CanPrefer}"
                                                VerticalAlignment="Center" Padding="12,6" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="RevertAutoBtn" Content="Revert to Automatic" Click="OnRevertAutomatic"
                                Padding="14,7" Margin="0,0,8,0" />
                        <Button x:Name="RestorePrevBtn" Content="Restore previous" Click="OnRestorePrevious"
                                Padding="14,7" />
                        <TextBlock x:Name="IfaceStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" />
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Apps that are already connected keep their current connection until they reconnect, so the switch isn't always instant." />
                </StackPanel>
            </Border>

            <!-- ════ ForceBindIP setup (only while not installed) ════════════════ -->
            <Border x:Name="FbipSetupCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Set up ForceBindIP" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Per-app connection binding needs ForceBindIP, a small portable tool. Download it from the official site, then extract ForceBindIP64.exe (and ForceBindIP.exe) into Bansa's Tools folder. This card disappears once it's there." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Download ForceBindIP →" Click="OnGetForceBindIp"
                                Style="{StaticResource AccentButton}" Padding="16,8" Margin="0,0,8,0" />
                        <Button Content="Open Tools folder" Click="OnOpenToolsFolder" Padding="14,8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════ App ↔ connection binding ═══════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="App → connection binding" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="FbipStatusText" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}" />
                    </Grid>
                    <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Launch an app with its traffic forced out one connection — e.g. one app over Wi-Fi, another over Ethernet. Uses ForceBindIP." />

                    <!-- App picker -->
                    <TextBlock Text="Application" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="AppSearchBox" Padding="6,5" VerticalContentAlignment="Center" Margin="0,0,0,6"
                             TextChanged="OnAppSearchChanged" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AppCombo" Grid.Column="0" Padding="6,5"
                                  DisplayMemberPath="Display" SelectionChanged="OnAppSelected" />
                        <Button x:Name="BrowseBtn" Grid.Column="2" Content="Browse…" Click="OnBrowse" Padding="14,6" />
                    </Grid>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"
                               Text="Type above to filter apps Bansa knows from history, pick from the list, or Browse to any .exe." />
                    <TextBlock x:Name="PickedPathText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,12"
                               Text="No app selected." />

                    <!-- Connection -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="↻ Refresh" Click="OnRefreshAdapters"
                                Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand"
                                Foreground="{DynamicResource AccentBrush}" FontSize="11.5" />
                    </Grid>
                    <ComboBox x:Name="AdapterCombo" Padding="6,5" DisplayMemberPath="Display" Margin="0,0,0,4" />
                    <TextBlock x:Name="NoAdaptersText" Visibility="Collapsed" Foreground="#F59E0B" FontSize="11.5"
                               Margin="0,0,0,4" Text="No active network adapters with an IPv4 address were found." />

                    <!-- Arguments -->
                    <TextBlock Text="Arguments (optional)" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" Margin="0,10,0,6" />
                    <TextBox x:Name="ArgsBox" Padding="6,5" VerticalContentAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="LaunchBtn" Content="Launch bound" Click="OnLaunch"
                                Style="{StaticResource AccentButton}" Padding="18,8" MinWidth="130" />
                        <TextBlock x:Name="BindStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   FontSize="11.5" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Running bound apps -->
                    <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Running bound apps" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="Status checks each app's live connections against the bound IP. Binding leaves nothing on your system — closing the app, or Stop, fully reverses it." />
                            <TextBlock x:Name="ActiveEmpty" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="No bound apps are running." />
                            <ItemsControl x:Name="ActiveItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="6"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top"
                                                         Margin="0,4,9,0" Fill="{Binding StatusBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding ProtoBrush}"
                                                                Visibility="{Binding ProtoVisibility}"
                                                                ToolTip="ForceBindIP binds IPv4 only — an app on IPv6 won't be bound.">
                                                            <TextBlock Text="{Binding ProtoText}" FontSize="10" FontWeight="Medium"
                                                                       Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SubText}" FontSize="11"
                                                               Foreground="{DynamicResource SubtleTextBrush}" Margin="0,1,0,0" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                               Foreground="{Binding StatusBrush}" Margin="0,2,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}"
                                                        VerticalAlignment="Center" Padding="12,5" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ════ Connection scan ═════════════════════════════════════════════ -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection scan" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="ScanBtn" Content="Scan now" Click="OnScan" Padding="16,5" />
                    </Grid>
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Which connection each running app is actually using right now. Apps on a connection other than the active one are flagged — handy to catch apps that ignored your preference. Click Scan now to take a snapshot." />

                    <TextBlock x:Name="ScanActiveText" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />

                    <CheckBox x:Name="OnlyMismatchCheck" Content="Only show apps not on the active connection"
                              Foreground="{DynamicResource SubtleTextBrush}" FontSize="11.5" Margin="0,0,0,10"
                              Click="OnMismatchFilterChanged" />

                    <TextBlock x:Name="ScanEmpty" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}"
                               Text="Click “Scan now” to list running apps and the connection each is using." />
                    <ItemsControl x:Name="ScanItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                                <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" Background="{Binding StatusBrush}">
                                                    <TextBlock Text="{Binding InterfacesText}" FontSize="10" FontWeight="Medium"
                                                               Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{Binding StatusBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Bind to active…" Command="{Binding BindCommand}"
                                                IsEnabled="{Binding CanBind}" Visibility="{Binding BindVisibility}"
                                                VerticalAlignment="Center" Padding="12,6" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
